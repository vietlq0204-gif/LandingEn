@{
    var layoutData = ViewData["LayoutData"] as LayoutViewModel ?? new LayoutViewModel();
    var baseInfo = ViewData["BaseInfo"] as BaseInfoViewModel ?? new BaseInfoViewModel();
    var currentTitle = ViewData["Title"]?.ToString();
    var pageTitle = string.IsNullOrWhiteSpace(currentTitle)
        ? baseInfo.BrandName
        : $"{currentTitle}{layoutData.TitleSeparator}{baseInfo.BrandName}";
}

<!DOCTYPE html>
<html lang="@layoutData.Language">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="@layoutData.MetaDescription" />
    <title>@pageTitle</title>
    @foreach (var preconnectUrl in baseInfo.PreconnectUrls ?? Array.Empty<string>())
    {
        <link rel="preconnect" href="@preconnectUrl" />
    }
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/typography.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/popups.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
<header class="site-header">
    <nav class="main-nav" aria-label="@layoutData.Navigation.AriaLabel">
        <div class="page-shell main-nav__inner">
            <a class="brand" href="@baseInfo.Urls.Home" aria-label="@baseInfo.BrandName">
                <img src="@baseInfo.Logos.Page.ImageUrl" alt="@baseInfo.Logos.Page.Alt" />
            </a>
            <input class="nav-toggle" type="checkbox" id="nav-toggle" aria-label="@layoutData.Navigation.ToggleAriaLabel" />
            <label class="nav-toggle-label" for="nav-toggle" aria-hidden="true">
                <span></span>
                <span></span>
                <span></span>
            </label>
            <div class="nav-links">
                @foreach (var link in layoutData.Navigation.Links ?? Array.Empty<NavigationLinkData>())
                {
                    <a href="@link.Href">@link.Text</a>
                }
            </div>
            @if (layoutData.Navigation.Cta.OpensTestModal)
            {
                <a class="nav-cta" href="@layoutData.Navigation.Cta.Href" data-test-trigger>@layoutData.Navigation.Cta.Text</a>
            }
            else
            {
                <a class="nav-cta" href="@layoutData.Navigation.Cta.Href">@layoutData.Navigation.Cta.Text</a>
            }
        </div>
    </nav>
</header>

<main>
    @RenderBody()
</main>

@await Html.PartialAsync("_Popups", ViewData["ContactInfo"] as ContactInfoViewModel ?? new ContactInfoViewModel())

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
