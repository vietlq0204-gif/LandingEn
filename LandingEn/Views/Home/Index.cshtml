@{
    ViewData["Title"] = "Trung Tâm Tiếng Anh Giao Tiếp TPHCM";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Home.css" asp-append-version="true" />
}

<section class="hero" id="home">
    <div class="hero__media" aria-hidden="true"></div>
    <div class="hero__overlay"></div>
    <div class="page-shell hero__content">
        <p class="eyebrow">100% giáo viên nước ngoài</p>
        <h1>Tiếng Anh Nghe Nói</h1>
        <p class="hero__lead">Trung tâm tiếng Anh giao tiếp tại TPHCM giúp học viên luyện nghe nói, phát âm và phản xạ trong môi trường thực hành liên tục.</p>
        <div class="hero__actions">
            <a class="btn-primary" href="#test-popup" data-test-trigger>Test miễn phí</a>
            <a class="btn-secondary" asp-controller="Home" asp-action="Courses">Xem khóa học</a>
        </div>
    </div>
</section>

<section class="intro section" id="intro">
    <div class="page-shell split-layout">
        <div class="intro__image">
            <img src="https://tienganhnghenoi.vn/wp-content/uploads/2026/05/homepage-hinh.jpg" alt="Học viên Tiếng Anh Nghe Nói" />
        </div>
        <div class="intro__copy">
            <p class="eyebrow">Trung tâm tiếng Anh nghe nói</p>
            <h2>Nơi tiếng Anh trở thành phản xạ</h2>
            <p>Với hơn 13 năm đào tạo tiếng Anh giao tiếp, trung tâm tập trung vào lớp học sĩ số nhỏ, thực hành trực tiếp và lộ trình phù hợp từng trình độ.</p>
            <p>Học viên được luyện phát âm, nghe hiểu, tư duy bằng tiếng Anh và xử lý các tình huống giao tiếp thật trong học tập, công việc, du lịch và hội nhập.</p>
            <a class="text-link" href="#roadmap">Xem lộ trình</a>
        </div>
    </div>
</section>

<section class="stats-band">
    <div class="page-shell stats-grid">
        <div>
            <strong>13+</strong>
            <span>Năm phát triển</span>
        </div>
        <div>
            <strong>250</strong>
            <span>Giáo viên</span>
        </div>
        <div>
            <strong>380.000</strong>
            <span>Học viên</span>
        </div>
        <div>
            <strong>6-12</strong>
            <span>Học viên mỗi lớp</span>
        </div>
    </div>
</section>

<section class="why section">
    <div class="page-shell">
        <div class="section-heading">
            <p class="eyebrow">Tại sao chọn</p>
            <h2>Tiếng Anh Nghe Nói</h2>
        </div>
        <div class="why-grid">
            <article>
                <span class="feature-icon">01</span>
                <h3>Giáo trình bài bản</h3>
                <p>Chương trình được chia theo trình độ, mục tiêu và tình huống sử dụng tiếng Anh thực tế.</p>
            </article>
            <article>
                <span class="feature-icon">02</span>
                <h3>Đa dạng học viên</h3>
                <p>Phù hợp người mất gốc, sinh viên, người đi làm và học viên muốn nâng cao giao tiếp.</p>
            </article>
            <article>
                <span class="feature-icon">03</span>
                <h3>Giáo viên nước ngoài</h3>
                <p>Lớp học được dẫn dắt bởi giáo viên quốc tế có kinh nghiệm, thân thiện và thực tế.</p>
            </article>
            <article>
                <span class="feature-icon">04</span>
                <h3>Phản xạ độc quyền</h3>
                <p>Phương pháp Face-to-Face tăng thời gian tương tác và giúp học viên nói tự nhiên hơn.</p>
            </article>
        </div>
    </div>
</section>

<section class="courses section section-soft" id="courses">
    <div class="page-shell">
        <div class="section-heading">
            <p class="eyebrow">Khóa học nổi bật</p>
            <h2>Các lớp tiếng Anh giao tiếp</h2>
        </div>
        <div class="course-grid">
            <article class="course-card">
                <img src="https://tienganhnghenoi.vn/wp-content/uploads/2025/11/lop-nhom-vuong-1-min.jpg" alt="Lớp mất gốc" />
                <div>
                    <h3>Lớp mất gốc</h3>
                    <p>Củng cố nền tảng phát âm, ngữ pháp căn bản và phản xạ nghe nói ban đầu.</p>
                    <a href="#contact">Đăng ký tư vấn</a>
                </div>
            </article>
            <article class="course-card">
                <img src="https://tienganhnghenoi.vn/wp-content/uploads/2026/05/tieng-anh-nghe-noi-lop-nhom.jpg" alt="Lớp giao tiếp nhóm" />
                <div>
                    <h3>Lớp giao tiếp nhóm</h3>
                    <p>Sĩ số thấp, tương tác liên tục, phù hợp học viên muốn nói tự tin mỗi ngày.</p>
                    <a href="#contact">Đăng ký tư vấn</a>
                </div>
            </article>
            <article class="course-card">
                <img src="https://tienganhnghenoi.vn/wp-content/uploads/2025/11/lop-online-web-min.jpg" alt="Lớp cá nhân hóa" />
                <div>
                    <h3>Lớp cá nhân hóa</h3>
                    <p>Online hoặc offline, thiết kế theo mục tiêu riêng và lịch học linh hoạt.</p>
                    <a href="#contact">Đăng ký tư vấn</a>
                </div>
            </article>
            <article class="course-card">
                <img src="https://tienganhnghenoi.vn/wp-content/uploads/2023/08/lop-cong-ty-3.jpg" alt="Lớp công ty tại nhà" />
                <div>
                    <h3>Lớp công ty/tại nhà</h3>
                    <p>Chương trình dành cho đội nhóm, doanh nghiệp hoặc học viên cần giáo viên riêng.</p>
                    <a href="#contact">Đăng ký tư vấn</a>
                </div>
            </article>
        </div>
    </div>
</section>

<section class="roadmap section" id="roadmap">
    <div class="page-shell split-layout split-layout--wide">
        <div>
            <p class="eyebrow">Lộ trình học</p>
            <h2>Từ mất gốc đến giao tiếp tự tin</h2>
            <p>Lộ trình tập trung vào vốn từ, cấu trúc câu, phát âm, nghe hiểu và phản xạ giao tiếp trong tình huống thật. Mỗi cấp độ có mục tiêu rõ để học viên thấy tiến bộ sau từng chặng.</p>
            <div class="level-list">
                <div><span>0</span><strong>Mất gốc</strong><p>Làm quen IPA, câu cơ bản và phản xạ nền tảng.</p></div>
                <div><span>1</span><strong>Sơ cấp</strong><p>Giao tiếp chủ đề quen thuộc trong cuộc sống.</p></div>
                <div><span>2</span><strong>Trung cấp</strong><p>Luyện suy nghĩ bằng tiếng Anh và phản hồi nhanh hơn.</p></div>
                <div><span>3</span><strong>Nâng cao</strong><p>Thảo luận, thuyết trình và phản biện tự nhiên.</p></div>
            </div>
        </div>
        <div class="roadmap__image">
            <img src="https://tienganhnghenoi.vn/wp-content/uploads/2025/11/lo-trinh-adult-1-min.jpg" alt="Lộ trình học tiếng Anh giao tiếp" />
        </div>
    </div>
</section>

