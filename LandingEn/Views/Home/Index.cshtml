@model HomePageViewModel

@{
    var home = Model.Home;
    var contact = Model.Contact;
    var baseInfo = Model.BaseInfo;
    var footerLogo = string.IsNullOrWhiteSpace(baseInfo.Logos.Footer.ImageUrl)
        ? baseInfo.Logos.Page
        : baseInfo.Logos.Footer;
    ViewData["Title"] = home.Title;
}

@section Styles {
    <link rel="stylesheet" href="~/css/Home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Course.css" asp-append-version="true" />
}

<section class="hero" id="home">
    <div class="hero__media" style="background-image: url('@home.Hero.BackgroundImageUrl')" aria-hidden="true"></div>
    <div class="hero__overlay"></div>
    <div class="page-shell hero__content">
        <p class="eyebrow">@home.Hero.Eyebrow</p>
        <h1>@home.Hero.Heading</h1>
        <p class="hero__lead">@home.Hero.Lead</p>
        <div class="hero__actions">
            <a class="btn-primary" href="@home.Hero.PrimaryActionHref" data-test-trigger>@home.Hero.PrimaryActionText</a>
            <a class="btn-secondary" href="@home.Hero.SecondaryActionHref">@home.Hero.SecondaryActionText</a>
        </div>
    </div>
</section>

<section class="intro section" id="intro">
    <div class="page-shell split-layout">
        <div class="intro__image">
            <img src="@home.Intro.ImageUrl" alt="@home.Intro.ImageAlt" />
        </div>
        <div class="intro__copy">
            <p class="eyebrow">@home.Intro.Eyebrow</p>
            <h2>@home.Intro.Heading</h2>
            @foreach (var paragraph in home.Intro.Paragraphs ?? Array.Empty<string>())
            {
                <p>@paragraph</p>
            }
            <a class="text-link" href="@home.Intro.LinkHref">@home.Intro.LinkText</a>
        </div>
    </div>
</section>

<section class="stats-band">
    <div class="page-shell stats-grid">
        @foreach (var stat in home.Stats ?? Array.Empty<StatItemData>())
        {
            <div>
                <strong>@stat.Value</strong>
                <span>@stat.Label</span>
            </div>
        }
    </div>
</section>

<section class="why section">
    <div class="page-shell">
        <div class="section-heading">
            <p class="eyebrow">@home.Why.Eyebrow</p>
            <h2>@home.Why.Heading</h2>
        </div>
        <div class="why-grid">
            @foreach (var item in home.Why.Items ?? Array.Empty<FeatureItemData>())
            {
                <article>
                    <span class="feature-icon">@item.Number</span>
                    <h3>@item.Title</h3>
                    <p>@item.Text</p>
                </article>
            }
        </div>
    </div>
</section>

<section class="courses-page courses-page--embedded" id="courses">
    <div class="page-shell">
        <header class="courses-page__heading section-heading">
            <p class="eyebrow">@home.Courses.Eyebrow</p>
            <h2>@home.Courses.Heading</h2>
        </header>

        <div class="courses-page__workspace" data-course-layout>
            <form class="course-filter" data-course-filter>
                <div class="course-filter__header">
                    @* <button class="course-filter__close" type="button" aria-label="T&#7841;m &#273;&#243;ng b&#7843;ng l&#7885;c" aria-expanded="true" data-course-filter-close>&times;</button> *@
                </div>
                <label class="course-filter__field course-filter__field--wide">
                    <span>T&#234;n kh&#243;a h&#7885;c</span>
                    <input type="search" name="courseName" placeholder="Nh&#7853;p t&#234;n kh&#243;a h&#7885;c..." autocomplete="off" />
                </label>
                <label class="course-filter__field">
                    <span>Lo&#7841;i kh&#243;a h&#7885;c</span>
                    <div class="course-type-field" data-course-type-select>
                        <button class="course-type-field__trigger" type="button" aria-expanded="false">
                            <span>T&#7845;t c&#7843; lo&#7841;i kh&#243;a h&#7885;c</span>
                            <span class="course-type-field__caret"></span>
                        </button>
                        <input type="hidden" name="courseType" value="" />
                        <div class="course-type-field__dropdown">
                            <button type="button" data-value="">T&#7845;t c&#7843; lo&#7841;i kh&#243;a h&#7885;c</button>
                            <button type="button" data-value="giao-tiep">Giao ti&#7871;p</button>
                            <button type="button" data-value="kem-1-1">K&#232;m 1-1</button>
                            <button type="button" data-value="mat-goc">M&#7845;t g&#7889;c</button>
                            <button type="button" data-value="online">Online</button>
                            <button type="button" data-value="doanh-nghiep">Doanh nghi&#7879;p</button>
                        </div>
                    </div>
                </label>
                <div class="course-filter__field course-filter__field--wide course-filter__range-field">
                    <span>Kho&#7843;ng gi&#225;</span>
                    <div class="course-price-range" data-course-price-range>
                        <div class="course-price-range__values">
                            <output data-course-min-price>0&#273;</output>
                            <output data-course-max-price>10.000.000&#273;</output>
                        </div>
                        <div class="course-price-range__slider">
                            <input type="range" name="minPrice" min="0" max="10000000" step="50000" value="0" aria-label="Gi&#225; th&#7845;p nh&#7845;t" />
                            <input type="range" name="maxPrice" min="0" max="10000000" step="50000" value="10000000" aria-label="Gi&#225; cao nh&#7845;t" />
                        </div>
                    </div>
                </div>
            </form>

            <div class="course-results">
                <button class="course-filter-toggle" type="button" aria-label="M&#7903; b&#7843;ng l&#7885;c" aria-expanded="false" data-course-filter-open hidden>
                    <img src="/img/filter-button.svg" alt="" />
                </button>

                <div class="course-list" data-course-list>
                    @foreach (var course in Model.Courses)
                    {
                        <article class="course-list__card"
                                 data-course-card
                                 data-title="@course.Title"
                                 data-type="@course.Type"
                                 data-price="@course.Price"
                                 data-course-video="@course.VideoUrl"
                                 data-course-detail="@course.DetailDescription"
                                 data-course-audience="@course.Audience"
                                 data-course-schedule="@course.Schedule"
                                 data-course-roadmap="@course.Roadmap">
                            <img src="@course.ImageUrl" alt="@course.ImageAlt" />
                            <div class="course-list__body">
                                <h2>@course.Title</h2>
                                <p>@course.Summary</p>
                                <div class="course-list__meta">
                                    <span class="course-list__tag">@course.Tag</span>
                                    <span>@course.Audience</span>
                                    <span>@course.Schedule</span>
                                </div>
                                <strong>@course.DisplayPrice</strong>
                                <a href="#test-popup" data-test-trigger>&#272;&#259;ng k&#253; t&#432; v&#7845;n</a>
                            </div>
                        </article>
                    }
                </div>

                <p class="course-list__empty" data-course-empty>Kh&#244;ng t&#236;m th&#7845;y kh&#243;a h&#7885;c ph&#249; h&#7907;p.</p>
            </div>
        </div>
    </div>
</section>

<section class="roadmap section" id="roadmap">
    <div class="page-shell split-layout split-layout--wide">
        <div>
            <p class="eyebrow">@home.Roadmap.Eyebrow</p>
            <h2>@home.Roadmap.Heading</h2>
            <p>@home.Roadmap.Text</p>
            <div class="level-list">
                @foreach (var level in home.Roadmap.Levels ?? Array.Empty<RoadmapLevelData>())
                {
                    <div>
                        <span>@level.Number</span>
                        <strong>@level.Title</strong>
                        <p>@level.Text</p>
                    </div>
                }
            </div>
        </div>
        <div class="roadmap__image">
            <img src="@home.Roadmap.ImageUrl" alt="@home.Roadmap.ImageAlt" />
        </div>
    </div>
</section>

<section class="teachers section section-dark" id="teachers">
    <div class="page-shell">
        <div class="section-heading section-heading--light">
            <p class="eyebrow">@home.Teachers.Eyebrow</p>
            <h2>@home.Teachers.Heading</h2>
            <p>@home.Teachers.Text</p>
        </div>
        <div class="teacher-grid">
            @foreach (var teacher in home.Teachers.Items ?? Array.Empty<ImageTitleData>())
            {
                <article>
                    <img src="@teacher.ImageUrl" alt="@teacher.ImageAlt" />
                    <h3>@teacher.Title</h3>
                </article>
            }
        </div>
    </div>
</section>

<section class="motto section">
    <div class="page-shell motto__inner">
        <div>
            <p class="eyebrow">@home.Motto.Eyebrow</p>
            <h2>@home.Motto.Heading</h2>
            <p>@home.Motto.Text</p>
        </div>
        <blockquote>
            <p>@home.Motto.Quote</p>
            <cite>@home.Motto.Cite</cite>
        </blockquote>
    </div>
</section>

<section class="gallery section section-soft" id="gallery">
    <div class="page-shell">
        <div class="section-heading">
            <p class="eyebrow">@home.Gallery.Eyebrow</p>
            <h2>@home.Gallery.Heading</h2>
        </div>
        <div class="gallery-grid">
            @foreach (var item in home.Gallery.Items ?? Array.Empty<GalleryItemData>())
            {
                <figure>
                    <img src="@item.ImageUrl" alt="@item.ImageAlt" />
                    <figcaption>@item.Caption</figcaption>
                </figure>
            }
        </div>
    </div>
</section>

<section class="video-section section">
    <div class="page-shell split-layout split-layout--wide">
        <div>
            <p class="eyebrow">@home.Videos.Eyebrow</p>
            <h2>@home.Videos.Heading</h2>
            <p>@home.Videos.Text</p>
        </div>
        <div class="video-grid">
            @foreach (var item in home.Videos.Items ?? Array.Empty<string>())
            {
                <article>
                    <span>▶</span>
                    <p>@item</p>
                </article>
            }
        </div>
    </div>
</section>

<section class="testimonials section section-dark">
    <div class="page-shell">
        <div class="section-heading section-heading--light">
            <p class="eyebrow">@home.Testimonials.Eyebrow</p>
            <h2>@home.Testimonials.Heading</h2>
        </div>
        <div class="testimonial-grid">
            @foreach (var testimonial in home.Testimonials.Items ?? Array.Empty<TestimonialItemData>())
            {
                <article>
                    <div class="stars">@testimonial.Stars</div>
                    <p>@testimonial.Text</p>
                    <h3>@testimonial.Name</h3>
                </article>
            }
        </div>
    </div>
</section>

<section class="news section" id="news">
    <div class="page-shell">
        <div class="section-heading">
            <p class="eyebrow">@home.News.Eyebrow</p>
            <h2>@home.News.Heading</h2>
        </div>
        <div class="news-grid">
            @foreach (var item in home.News.Items ?? Array.Empty<NewsItemData>())
            {
                <article class="news-card">
                    <img src="@item.ImageUrl" alt="@item.ImageAlt" />
                    <div>
                        <span>@item.Date</span>
                        <h3>@item.Title</h3>
                        <p>@item.Text</p>
                    </div>
                </article>
            }
        </div>
    </div>
</section>

<footer class="site-footer" id="contact">
    <div class="page-shell footer-grid">
        <div>
            <img class="footer-logo" src="@footerLogo.ImageUrl" alt="@footerLogo.Alt" />
            <p>@home.Footer.Description</p>
            <p><strong>@home.Footer.PhoneLabel:</strong> @baseInfo.PhoneDisplay</p>
        </div>
        @foreach (var group in home.Footer.LinkGroups ?? Array.Empty<FooterLinkGroupData>())
        {
            <div>
                <h3>@group.Heading</h3>
                @foreach (var link in group.Links ?? Array.Empty<FooterLinkData>())
                {
                    <a href="@link.Href">@link.Text</a>
                }
            </div>
        }
        <div>
            <h3>@home.Footer.AddressesHeading</h3>
            @foreach (var address in contact.Addresses ?? Array.Empty<string>())
            {
                <p>@address</p>
            }
        </div>
    </div>
    <div class="page-shell footer-bottom">@home.Footer.Copyright</div>
</footer>
